rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // El perfil y el saldo inicial tienen permisos independientes.
    match /usuarios/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nombreCompleto'])
        && request.resource.data.nombreCompleto is string
        && request.resource.data.nombreCompleto.size() >= 1
        && request.resource.data.nombreCompleto.size() <= 100
        && request.resource.data.nombreCompleto.matches('.*\\S.*');
    }
    match /usuarios/{uid}/movimientos/{movementId} {
      function deletionMarker() {
        return /databases/$(database)/documents/usuarios/$(uid)/movimientosEliminados/$(movementId);
      }
      function validMovement() {
        let data = request.resource.data;
        return !exists(deletionMarker())
          && movementId.matches('[a-f0-9-]{36}')
          && data.centimos is int && data.centimos > 0
          && data.dia is int
          && data.dia >= get(/databases/$(database)/documents/usuarios/$(uid)/efectivo/saldoInicial).data.dia
          && data.dia <= 2932896
          && data.dia * 86400000 <= (request.time + duration.value(14, 'h')).toMillis()
          && data.categoria in ['INCOME', 'LEISURE', 'HOUSING', 'FOOD', 'TRANSPORT', 'HEALTH', 'OTHER']
          && data.nota is string && data.nota.size() <= 500;
      }
      allow read: if request.auth != null && request.auth.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid && existsAfter(deletionMarker());
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['centimos', 'dia', 'categoria', 'nota'])
        && validMovement();
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['centimos', 'dia', 'categoria', 'nota', 'revision'])
        && request.resource.data.revision is string
        && request.resource.data.revision.matches('[a-f0-9-]{36}')
        && request.resource.data.revision != resource.data.get('revision', '')
        && validMovement();
    }
    // Reserva el identificador eliminado para que un reintento de alta no lo reactive.
    match /usuarios/{uid}/movimientosEliminados/{movementId} {
      function movement() {
        return /databases/$(database)/documents/usuarios/$(uid)/movimientos/$(movementId);
      }
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['eliminado'])
        && request.resource.data.eliminado == true
        && exists(movement()) && !existsAfter(movement());
    }
    match /usuarios/{uid}/efectivo/saldoInicial {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['centimos', 'dia'])
        && request.resource.data.centimos is int
        && request.resource.data.dia is int
        // Días desde 1970-01-01, acotados a los años de calendario 1 a 9999.
        && request.resource.data.dia >= -719162
        && request.resource.data.dia <= 2932896
        // El servidor admite el día vigente en UTC+14; la app valida con la fecha local.
        && request.resource.data.dia * 86400000 <= (request.time + duration.value(14, 'h')).toMillis();
    }
  }
}
